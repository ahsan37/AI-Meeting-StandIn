{
  "name": "presentation-takeover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx server/index.ts",
    "start": "NODE_ENV=production node --import tsx server/index.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.36.0",
    "express": "5.3.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
